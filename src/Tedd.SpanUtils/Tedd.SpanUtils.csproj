<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net6.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(EnableNet11)' == 'true'">$(TargetFrameworks);net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>2.0.0</Version>
    <Authors>Tedd Hansen</Authors>
    <Company>Tedd Hansen</Company>
    <Copyright>Tedd Hansen</Copyright>
    <Description>High-performance binary serialization for Span and Memory: endian-aware primitives, variable-length integers, UTF-8, and bounded stream adapters.</Description>
    <PackageTags>Span Memory Binary Serialization Endianness UTF8 VLQ</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/tedd/Tedd.SpanUtils</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tedd/Tedd.SpanUtils.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Version 2: .NET Standard 2.1 and .NET 6 minimums, optimized .NET 10 target, expanded serialization APIs, checked bounds, corrected stream semantics, and archived comparative benchmarks. See README for migration details.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsTrimmable Condition="'$(TargetFramework)' != 'netstandard2.1'">true</IsTrimmable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <DefineConstants>$(DefineConstants);BEFORENETCOREAPP3;NETSTANDARD21</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
